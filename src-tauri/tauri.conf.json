{
    "build": {
        "distDir": "../dist",
        "devPath": "http://localhost:8000"
    },
    "package": {
        "productName": "METAR-TAF Visualizer",
        "version": "2.0.0"
    },
    "tauri": {
        "allowlist": {
            "all": false,
            "shell": {
                "all": false,
                "open": true
            },
            "http": {
                "all": true,
                "request": true
            }
        },
        "windows": [
            {
                "title": "METAR/TAF Visualizer",
                "width": 1280,
                "height": 900,
                "minWidth": 800,
                "minHeight": 600,
                "resizable": true,
                "fullscreen": false
            }
        ],
        "security": {
            "csp": null
        },
        "bundle": {
            "active": true,
            "targets": ["msi", "nsis"],
            "identifier": "com.papabear.metartaf",
            "icon": [
                "icons/32x32.png",
                "icons/128x128.png",
                "icons/icon.ico"
            ]
        }
    }
}
